    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C (通用)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}", // 核心：自动识别当前文件编译出的程序
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true, // 关键：会弹出一个独立的终端，scanf 随便用
            "MIMode": "lldb",        // macOS 必须用 lldb，不能用 gdb
            "preLaunchTask": "build C file" // 运行前自动执行编译任务
        }

       

    ]
}